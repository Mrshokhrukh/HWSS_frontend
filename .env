# .env

# API Service Configuration
VITE_API_HOST=localhost
VITE_API_PORT=8123
VITE_API_PROTOCOL=http

# Screening Service Configuration
VITE_SCREENING_HOST=localhost
VITE_SCREENING_PORT=8686
VITE_SCREENING_PROTOCOL=http

# Development Mode Flag
VITE_DEVELOPMENT_MODE=true

# Any other environment-specific variables can be added here
# For example:
# VITE_APP_TITLE=My Vue.js App
# VITE_API_TIMEOUT=5000